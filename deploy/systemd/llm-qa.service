[Unit]
Description=LLM QA Streamlit Service
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/www/github/llm
ExecStart=/root/www/github/llm/.venv/bin/streamlit run rag/qa.py --server.port 8501 --server.address 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
